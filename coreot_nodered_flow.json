[
  {
    "id": "coreot-demo-tab",
    "type": "tab",
    "label": "CoreOT — CNC-DEMO-01 Controller",
    "disabled": false,
    "info": "Dashboard controls that POST telemetry to the CoreOT backend so the CNC-DEMO-01 machine changes live on the React web app."
  },
  {
    "id": "ui-group",
    "type": "ui_group",
    "name": "CNC-DEMO-01",
    "tab": "ui-tab",
    "order": 1,
    "disp": true,
    "width": "10",
    "collapse": false
  },
  {
    "id": "ui-tab",
    "type": "ui_tab",
    "name": "CoreOT Demo",
    "icon": "settings_input_component",
    "order": 1
  },
  {
    "id": "state",
    "type": "change",
    "z": "coreot-demo-tab",
    "name": "Set base state",
    "rules": [
      {
        "t": "set",
        "p": "state",
        "pt": "flow",
        "to": "{\"asset_code\":\"CNC-DEMO-01\",\"machine_status\":\"RUNNING\",\"temperature\":62,\"vibration\":2.5,\"pressure\":5.4,\"rpm\":1450,\"voltage\":415,\"current\":12.4,\"power\":8.7,\"energy\":126.8,\"production_count\":640,\"good_count\":625,\"reject_count\":15}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "wires": [[]],
    "x": 170,
    "y": 60
  },
  {
    "id": "status-dd",
    "type": "ui_dropdown",
    "z": "coreot-demo-tab",
    "name": "Machine Status",
    "label": "Machine Status",
    "tooltip": "",
    "place": "Select",
    "group": "ui-group",
    "order": 1,
    "width": 5,
    "height": 1,
    "passthru": true,
    "multiple": false,
    "options": [
      { "label": "RUNNING", "value": "RUNNING", "type": "str" },
      { "label": "STOPPED", "value": "STOPPED", "type": "str" },
      { "label": "IDLE", "value": "IDLE", "type": "str" },
      { "label": "FAULT", "value": "FAULT", "type": "str" }
    ],
    "payload": "",
    "topic": "machine_status",
    "wires": [["build"]],
    "x": 180,
    "y": 120
  },
  {
    "id": "temp-slider",
    "type": "ui_slider",
    "z": "coreot-demo-tab",
    "name": "Temperature",
    "label": "Temperature (°C)",
    "tooltip": "20 – 120",
    "group": "ui-group",
    "order": 2,
    "width": 5,
    "height": 1,
    "passthru": true,
    "outs": "end",
    "topic": "temperature",
    "min": 20,
    "max": 120,
    "step": 1,
    "wires": [["build"]],
    "x": 170,
    "y": 180
  },
  {
    "id": "vib-slider",
    "type": "ui_slider",
    "z": "coreot-demo-tab",
    "name": "Vibration",
    "label": "Vibration (mm/s)",
    "group": "ui-group",
    "order": 3,
    "width": 5,
    "height": 1,
    "passthru": true,
    "topic": "vibration",
    "min": 0,
    "max": 20,
    "step": 0.1,
    "wires": [["build"]],
    "x": 170,
    "y": 240
  },
  {
    "id": "rpm-slider",
    "type": "ui_slider",
    "z": "coreot-demo-tab",
    "name": "RPM",
    "label": "RPM",
    "group": "ui-group",
    "order": 4,
    "width": 5,
    "height": 1,
    "passthru": true,
    "topic": "rpm",
    "min": 0,
    "max": 3000,
    "step": 10,
    "wires": [["build"]],
    "x": 170,
    "y": 300
  },
  {
    "id": "power-slider",
    "type": "ui_slider",
    "z": "coreot-demo-tab",
    "name": "Power",
    "label": "Power (kW)",
    "group": "ui-group",
    "order": 5,
    "width": 5,
    "height": 1,
    "passthru": true,
    "topic": "power",
    "min": 0,
    "max": 50,
    "step": 0.1,
    "wires": [["build"]],
    "x": 170,
    "y": 360
  },
  {
    "id": "prod-num",
    "type": "ui_numeric",
    "z": "coreot-demo-tab",
    "name": "Production",
    "label": "Production Count",
    "group": "ui-group",
    "order": 6,
    "width": 5,
    "height": 1,
    "passthru": true,
    "topic": "production_count",
    "min": 0,
    "max": 100000,
    "step": 1,
    "wires": [["build"]],
    "x": 170,
    "y": 420
  },
  {
    "id": "good-num",
    "type": "ui_numeric",
    "z": "coreot-demo-tab",
    "name": "Good",
    "label": "Good Count",
    "group": "ui-group",
    "order": 7,
    "width": 5,
    "height": 1,
    "passthru": true,
    "topic": "good_count",
    "min": 0,
    "max": 100000,
    "step": 1,
    "wires": [["build"]],
    "x": 170,
    "y": 480
  },
  {
    "id": "reject-num",
    "type": "ui_numeric",
    "z": "coreot-demo-tab",
    "name": "Reject",
    "label": "Reject Count",
    "group": "ui-group",
    "order": 8,
    "width": 5,
    "height": 1,
    "passthru": true,
    "topic": "reject_count",
    "min": 0,
    "max": 100000,
    "step": 1,
    "wires": [["build"]],
    "x": 170,
    "y": 540
  },
  {
    "id": "alarm-switch",
    "type": "ui_switch",
    "z": "coreot-demo-tab",
    "name": "Alarm",
    "label": "Raise Alarm",
    "tooltip": "",
    "group": "ui-group",
    "order": 9,
    "width": 5,
    "height": 1,
    "passthru": false,
    "decouple": "false",
    "topic": "alarm",
    "onvalue": "true",
    "onvalueType": "bool",
    "onicon": "",
    "oncolor": "",
    "offvalue": "false",
    "offvalueType": "bool",
    "wires": [["build"]],
    "x": 170,
    "y": 600
  },
  {
    "id": "build",
    "type": "function",
    "z": "coreot-demo-tab",
    "name": "Merge control → telemetry",
    "func": "let s = flow.get('state') || {\n  asset_code: 'CNC-DEMO-01',\n  machine_status: 'RUNNING',\n  temperature: 62, vibration: 2.5, pressure: 5.4,\n  rpm: 1450, voltage: 415, current: 12.4, power: 8.7,\n  energy: 126.8, production_count: 640, good_count: 625, reject_count: 15\n};\nif (msg.topic && msg.payload !== undefined) {\n  if (msg.topic === 'alarm') {\n    s.alarm = msg.payload === true || msg.payload === 'true';\n    if (s.alarm) s.alarm_message = 'Manual alarm from Node-RED';\n  } else {\n    s[msg.topic] = Number.isFinite(+msg.payload) ? +msg.payload : msg.payload;\n  }\n}\nflow.set('state', s);\nreturn { payload: { ...s, timestamp: new Date().toISOString() } };",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 300
  },
  {
    "id": "post",
    "type": "http request",
    "z": "coreot-demo-tab",
    "name": "POST /api/telemetry/ingest",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "CHANGE_ME_BACKEND_URL/api/telemetry/ingest",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "headers": [
      { "keyType": "Content-Type", "keyValue": "", "valueType": "application/json", "valueValue": "" },
      { "keyType": "X-Ingest-Key", "keyValue": "", "valueType": "REPLACE_WITH_INGEST_KEY", "valueValue": "" }
    ],
    "x": 800,
    "y": 300,
    "wires": [["debug"]]
  },
  {
    "id": "debug",
    "type": "debug",
    "z": "coreot-demo-tab",
    "name": "CoreOT Response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1060,
    "y": 300,
    "wires": []
  },
  {
    "id": "auto-tick",
    "type": "inject",
    "z": "coreot-demo-tab",
    "name": "Auto simulate (5s)",
    "props": [{ "p": "topic", "v": "_auto", "vt": "str" }],
    "repeat": "5",
    "crontab": "",
    "once": false,
    "onceDelay": "",
    "topic": "_auto",
    "x": 170,
    "y": 660,
    "wires": [["auto-fn"]]
  },
  {
    "id": "auto-fn",
    "type": "function",
    "z": "coreot-demo-tab",
    "name": "Auto physics",
    "func": "let s = flow.get('state');\nif (!s) return null;\nif (s.machine_status === 'RUNNING') {\n  s.temperature = +(s.temperature + (Math.random()*0.8 - 0.3)).toFixed(2);\n  s.vibration = Math.max(0.1, +(s.vibration + (Math.random()*0.4 - 0.2)).toFixed(2));\n  s.rpm = Math.max(1200, Math.min(1600, s.rpm + Math.floor(Math.random()*40 - 20)));\n  s.power = +(Math.max(6, s.power + (Math.random()*0.6 - 0.3))).toFixed(2);\n  s.energy = +(s.energy + s.power/720).toFixed(2);\n  if (Math.random() > 0.3) {\n    s.production_count += 1;\n    if (Math.random() > 0.05) s.good_count += 1;\n    s.reject_count = s.production_count - s.good_count;\n  }\n} else if (s.machine_status === 'STOPPED') {\n  s.rpm = 0; s.power = +(Math.max(0.3, s.power - 0.2)).toFixed(2);\n}\nflow.set('state', s);\nreturn { payload: { ...s, timestamp: new Date().toISOString() } };",
    "outputs": 1,
    "noerr": 0,
    "x": 400,
    "y": 660,
    "wires": [["post"]]
  }
]
